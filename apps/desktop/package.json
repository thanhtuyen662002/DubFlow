{
  "name": "@dubflow/desktop-shell",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs && esbuild src/main.ts --bundle --format=iife --outfile=dist/main.js",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "test": "node --experimental-strip-types test/queue.test.mjs && node --experimental-strip-types test/voices.test.mjs",
    "tauri:build": "tauri build --no-bundle --ci"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.8.4",
    "esbuild": "0.28.2",
    "typescript": "5.5.2",
    "vite": "8.3.1"
  }
}
