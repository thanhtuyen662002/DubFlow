{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubflow.local/contracts/release-soak-evidence-v1.json",
  "title": "DubFlow release soak evidence",
  "type": "object",
  "required": [
    "schema_version",
    "completed_jobs",
    "failed_jobs",
    "resumed_steps",
    "crash_recovered",
    "disk_pressure_observed",
    "dependency_outage_isolated",
    "updater_rollback_observed",
    "security_boundary_checked",
    "resource_profile",
    "state_path",
    "scenario",
    "clean_machine_rehearsed",
    "gpu_oom_recovered",
    "cpu_fallback_jobs",
    "corrupt_input_quarantined",
    "dead_worker_recovered",
    "artifact_hashes",
    "artifact_hashes_verified",
    "resumability_verified"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "completed_jobs": {"type": "array", "items": {"type": "string"}},
    "failed_jobs": {"type": "array", "items": {"type": "string"}},
    "resumed_steps": {"type": "integer", "minimum": 0},
    "crash_recovered": {"type": "boolean"},
    "disk_pressure_observed": {"type": "boolean"},
    "dependency_outage_isolated": {"type": "boolean"},
    "updater_rollback_observed": {"type": "boolean"},
    "security_boundary_checked": {"type": "boolean"},
    "resource_profile": {"type": "object"},
    "state_path": {"type": "string", "minLength": 1},
    "scenario": {"type": "object"},
    "clean_machine_rehearsed": {"type": "boolean"},
    "gpu_oom_recovered": {"type": "boolean"},
    "cpu_fallback_jobs": {"type": "array", "items": {"type": "string"}},
    "corrupt_input_quarantined": {"type": "boolean"},
    "dead_worker_recovered": {"type": "boolean"},
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "artifact_hashes_verified": {"type": "boolean"},
    "resumability_verified": {"type": "boolean"}
  },
  "additionalProperties": false
}
