{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubflow.local/contracts/project-lock/v1",
  "title": "DubFlow project ownership lock metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "pid", "start_token", "scope", "acquired_epoch_ms"],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "supervisor"},
    "pid": {"type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 10},
    "start_token": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "scope": {"const": "project-db-artifacts-temp"},
    "acquired_epoch_ms": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20}
  }
}
