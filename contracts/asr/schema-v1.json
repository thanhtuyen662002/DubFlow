{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubflow.local/contracts/asr/schema-v1.json",
  "title": "DubFlow local ASR transcript v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "source_kind", "language", "utterances", "chunks", "provenance", "vad_segments", "failures", "warnings", "suppressed_candidates"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "asr_transcript" },
    "source_kind": { "const": "asr" },
    "language": { "$ref": "#/$defs/language" },
    "utterances": {
      "type": "array",
      "items": { "$ref": "#/$defs/utterance" }
    },
    "chunks": {
      "type": "array",
      "items": { "$ref": "#/$defs/chunk" }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "vad_segments": {
      "type": "array",
      "items": { "$ref": "#/$defs/vad_segment" }
    },
    "failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/failure" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "suppressed_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/suppressed_candidate" }
    }
  },
  "$defs": {
    "positive_decimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "signed_decimal": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "time_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "$ref": "#/$defs/positive_decimal" },
        "denominator": { "$ref": "#/$defs/positive_decimal" }
      }
    },
    "time_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "ticks", "time_base"],
      "properties": {
        "kind": { "const": "time_point" },
        "schema_version": { "const": 1 },
        "ticks": { "$ref": "#/$defs/signed_decimal" },
        "time_base": { "$ref": "#/$defs/time_base" }
      }
    },
    "language": {
      "type": "string",
      "pattern": "^(und|[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*)$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word_id", "raw_text", "text", "start", "end", "confidence"],
      "properties": {
        "word_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "raw_text": { "type": "string", "minLength": 1, "maxLength": 512 },
        "text": { "type": "string", "minLength": 1, "maxLength": 512 },
        "start": { "$ref": "#/$defs/time_point" },
        "end": { "$ref": "#/$defs/time_point" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "utterance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utterance_id", "source_kind", "raw_text", "text", "start", "end", "language", "words", "confidence", "chunk_ids"],
      "properties": {
        "utterance_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source_kind": { "const": "asr" },
        "raw_text": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "start": { "$ref": "#/$defs/time_point" },
        "end": { "$ref": "#/$defs/time_point" },
        "language": { "$ref": "#/$defs/language" },
        "text": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "words": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/word" }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "chunk_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "window_start", "window_end", "core_start", "core_end", "status", "attempt"],
      "properties": {
        "chunk_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "window_start": { "$ref": "#/$defs/time_point" },
        "window_end": { "$ref": "#/$defs/time_point" },
        "core_start": { "$ref": "#/$defs/time_point" },
        "core_end": { "$ref": "#/$defs/time_point" },
        "status": { "enum": ["completed", "failed", "skipped"] },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 255 },
        "error_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "artifact_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "checkpoint_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "producer_version", "backend_id", "model_id", "model_version", "runtime", "timeline_contract", "config_hash", "input_hash", "requested_profile", "hardware_profile"],
      "properties": {
        "producer": { "type": "string", "minLength": 1, "maxLength": 128 },
        "producer_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "backend_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "runtime": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timeline_contract": { "const": "timeline-v1" },
        "config_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "input_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "requested_profile": { "enum": ["auto", "cpu", "gpu", "fixture"] },
        "hardware_profile": { "enum": ["cpu", "gpu", "fixture"] }
        ,"fallback_reason": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "chunk_id", "retryable", "attempt", "condition", "fallback_used"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "chunk_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "retryable": { "type": "boolean" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 255 },
        "condition": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "fallback_used": { "type": "boolean" }
      }
    },
    "vad_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "confidence"],
      "properties": {
        "start": { "$ref": "#/$defs/time_point" },
        "end": { "$ref": "#/$defs/time_point" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "suppressed_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "chunk_id", "raw_text", "start", "end", "confidence", "reason"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "chunk_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "raw_text": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "start": { "$ref": "#/$defs/time_point" },
        "end": { "$ref": "#/$defs/time_point" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    }
  }
}
