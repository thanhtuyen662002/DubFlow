{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubflow.local/contracts/capcut/import-pack/schema-v2.json",
  "title": "DubFlow portable import pack v2 with exact tick mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "pack_id",
    "assets",
    "tracks",
    "timeline"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "capcut_import_pack"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "assets": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "timeline": {
      "$ref": "#/$defs/timeline"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "kind",
        "relative_path",
        "content_hash",
        "size_bytes",
        "format"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,256}$"
        },
        "kind": {
          "enum": [
            "video",
            "original_audio",
            "dub_audio",
            "mixed_audio",
            "subtitle",
            "timeline",
            "metadata"
          ]
        },
        "relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\x00-\\\\x1f]+$"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        },
        "size_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id",
        "kind",
        "order",
        "asset_ids",
        "role",
        "enabled_by_default"
      ],
      "properties": {
        "track_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "subtitle"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "asset_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "role": {
          "enum": ["video", "original_audio", "dub_audio", "mixed_audio", "subtitle"]
        },
        "enabled_by_default": {"type": "boolean"},
        "mute_embedded_audio": {"type": "boolean"}
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_base",
        "duration_ticks",
        "cues"
      ],
      "properties": {
        "time_base": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 20
            },
            "denominator": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 20
            }
          }
        },
        "duration_ticks": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 20
            },
            {
              "type": "null"
            }
          ]
        },
        "cues": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cue_id",
              "start_ticks",
              "end_ticks"
            ],
            "properties": {
              "cue_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "start_ticks": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "maxLength": 20
              },
              "end_ticks": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$",
                "maxLength": 20
              },
              "asset_ids": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "track_id": {
                "type": "string",
                "maxLength": 128
              },
              "speaker_id": {
                "type": "string",
                "maxLength": 128
              },
              "voice_id": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        }
      }
    }
  }
}
