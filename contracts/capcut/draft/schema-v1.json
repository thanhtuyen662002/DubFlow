{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubflow.local/contracts/capcut/draft/schema-v1.json",
  "title": "DubFlow versioned CapCut direct draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "capcut_version", "pack_manifest_hash", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "capcut_direct_draft"},
    "capcut_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "pack_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "assets": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
  }
}
