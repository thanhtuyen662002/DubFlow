{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubflow.local/contracts/mastering/editorial-v1.json",
  "title": "DubFlow editorial decisions v1 (ADR-0054)",
  "description": "The decision log beside a mastering plan: per script unit the chosen candidates, the next best alternatives with scores and reasons, every candidate with its quality, duplicate group and evidence (with origin and confidence), the mode (content or signals_only), the user's edits and warnings. Written by the planner, read by the desktop to explain and to let the user pick another shot; never an input to rendering (the plan is).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "workflow", "plan_id", "mode", "units", "candidates", "edits", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "editorial_decisions"},
    "workflow": {"enum": ["product_showcase", "compilation_entertainment"]},
    "plan_id": {"type": "string", "maxLength": 128},
    "mode": {"enum": ["content", "signals_only"]},
    "units": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/unit"}},
    "candidates": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/candidate"}},
    "edits": {"$ref": "#/$defs/edits"},
    "warnings": {"type": "array", "maxItems": 500, "items": {"type": "string", "maxLength": 500}},
    "exclusions": {
      "description": "Optional (#805): what the user's exclusions did to this plan's shots. left_out: each shot left out and the exclusion (a shot id, a whole shot's id or a source id) that leaves it out, matched by id or by the footage the exclusion was made on; widened: an unsplit shot left out for a part of it the user named (P2-N22); reused: excluded footage used anyway because nothing else was left (a conflict for the user, never silent).",
      "type": "object", "additionalProperties": false, "required": ["left_out", "widened", "reused"],
      "properties": {
        "left_out": {"type": "object", "maxProperties": 5000, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 64}},
        "widened": {"type": "object", "maxProperties": 5000, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 64}},
        "reused": {"type": "array", "maxItems": 5000, "items": {"type": "string", "minLength": 1, "maxLength": 64}}
      }
    },
    "vision": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string"}, "model": {"type": "string"},
        "frames": {"type": "integer", "minimum": 0}, "asked": {"type": "integer", "minimum": 0},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "part": {"type": "string", "maxLength": 128},
    "coverage_map": {
      "description": "Optional (P2-N11, a programme part): how much of the part's footage has content evidence, and the largest stretches without any (source, start ms, end ms).",
      "type": "object", "additionalProperties": false,
      "properties": {"shots": {"type": "integer", "minimum": 0}, "shots_with_evidence": {"type": "integer", "minimum": 0},
                     "ms": {"type": "integer", "minimum": 0}, "ms_with_evidence": {"type": "integer", "minimum": 0},
                     "milli": {"type": "integer", "minimum": 0, "maximum": 1000},
                     "unseen": {"type": "array", "items": {"type": "array", "minItems": 3, "maxItems": 3}}}
    },
    "sources": {
      "description": "Optional (P2-N5, older logs lack it): source id → the source's content identity, so an approval given on a source whose content has since changed is invalidated while a new plan revision alone is not.",
      "type": "object", "additionalProperties": {"type": "string", "maxLength": 200}
    },
    "plan_inputs": {
      "description": "Optional (Bán hàng): the digest of the inputs of the plan this log was made with; a saved plan is reused only with its own log.",
      "type": "string", "maxLength": 64
    },
    "source_identity": {
      "description": "Optional: \"content\" when every value of sources is a file's content fingerprint alone (no analysis recipe); a source left out of sources could not be read and has an unknown identity. Approvals compare the sources' identity only then, and only when every shown source has one.",
      "type": "string", "enum": ["content"]
    },
    "provenance": {
      "description": "Optional (added for P2-14, older logs lack it): provenance → how many candidates carry evidence of it. filename_metadata is never content: a log with only file names (and signals) is signals_only.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vision": {"type": "integer", "minimum": 0}, "transcript": {"type": "integer", "minimum": 0},
        "user_note": {"type": "integer", "minimum": 0}, "ocr": {"type": "integer", "minimum": 0},
        "filename_metadata": {"type": "integer", "minimum": 0}, "signal": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "text", "function", "start_ms", "end_ms", "chosen", "alternatives", "notes"],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "text": {"type": "string", "maxLength": 3000},
        "function": {"enum": ["hook", "benefit", "demonstration", "feature", "result", "cta", "narration", "intro", "outro"]},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "chosen": {"type": "array", "items": {"type": "string"}},
        "alternatives": {"type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["candidate_id", "score", "reasons"],
          "properties": {"candidate_id": {"type": "string"}, "score": {"type": "integer"},
                         "reasons": {"type": "array", "items": {"type": "string", "maxLength": 300}}}}},
        "notes": {"type": "array", "items": {"type": "string", "maxLength": 300}},
        "pieces": {
          "description": "Optional (P2-N5, older logs lack it): what the sentence plays, in order: shot, source offset and length in ms. An approval keeps these pieces as constraints of the next plan.",
          "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "offset_ms", "length_ms"],
            "properties": {"id": {"type": "string"}, "offset_ms": {"type": "integer", "minimum": 0}, "length_ms": {"type": "integer", "minimum": 1},
                           "repeat": {"const": true}}}
        },
        "coverage": {
          "description": "How much of the sentence plays on footage that illustrates it (Phase 2 hardening); absent in older logs.",
          "type": "object", "additionalProperties": false,
          "required": ["need_ms", "illustrated_ms", "milli", "status", "needs_review", "matched_footage"],
          "properties": {"need_ms": {"type": "integer", "minimum": 0}, "illustrated_ms": {"type": "integer", "minimum": 0},
                         "milli": {"type": "integer", "minimum": 0, "maximum": 1000},
                         "status": {"enum": ["full", "partial", "none", "generic"]},
                         "needs_review": {"type": "boolean"}, "matched_footage": {"type": "integer", "minimum": 0},
                         "best_relevance": {"description": "The sentence's best relevance (0-1000) over the usable footage; a near miss (> 0) is never SOURCE_INSUFFICIENT. Absent in older logs.",
                                            "type": "integer", "minimum": 0, "maximum": 1000},
                         "user_ms": {"description": "Time the user's pinned shots fill that the AI saw no match in: the user's illustration, never counted in illustrated_ms or as evidence. Absent in older logs (whose pins counted as matches).",
                                     "type": "integer", "minimum": 0}}},
        "signals": {
          "description": "The separate signals behind the verdict (Gate S final closure): evidence reliability, semantic relevance, temporal coverage, allocation and review risk, each on its own scale. Explains the verdict, never changes it. Absent in older logs.",
          "type": "object", "additionalProperties": false,
          "required": ["evidence_reliability", "semantic_relevance", "temporal_coverage", "allocation", "review_risk"],
          "properties": {
            "evidence_reliability": {"type": "object", "additionalProperties": false, "required": ["mode", "min_trust", "max_trust"],
                                     "properties": {"mode": {"enum": ["content", "signals_only"]},
                                                    "min_trust": {"type": "integer", "minimum": 0, "maximum": 1000},
                                                    "max_trust": {"type": "integer", "minimum": 0, "maximum": 1000}}},
            "semantic_relevance": {"type": "object", "additionalProperties": false, "required": ["best", "chosen_min", "matched_footage"],
                                   "properties": {"best": {"type": "integer", "minimum": 0, "maximum": 1000},
                                                  "chosen_min": {"type": "integer", "minimum": 0, "maximum": 1000},
                                                  "matched_footage": {"type": "integer", "minimum": 0}}},
            "temporal_coverage": {"type": "object", "additionalProperties": false, "required": ["milli", "need_ms"],
                                  "properties": {"milli": {"type": "integer", "minimum": 0, "maximum": 1000},
                                                 "need_ms": {"type": "integer", "minimum": 0}}},
            "allocation": {"type": "object", "additionalProperties": false,
                           "required": ["own_ms", "neutral_ms", "repeat_ms", "held_ms", "pieces"],
                           "properties": {"own_ms": {"type": "integer", "minimum": 0}, "neutral_ms": {"type": "integer", "minimum": 0},
                                          "repeat_ms": {"type": "integer", "minimum": 0}, "held_ms": {"type": "integer", "minimum": 0},
                                          "pieces": {"type": "integer", "minimum": 0}}},
            "review_risk": {"type": "object", "additionalProperties": false, "required": ["min_confidence", "flagged_pieces", "needs_review"],
                            "properties": {"min_confidence": {"type": "integer", "minimum": 0, "maximum": 1000},
                                           "flagged_pieces": {"type": "integer", "minimum": 0},
                                           "needs_review": {"type": "boolean"}}},
            "claims": {"description": "Only for a sentence that states a number, a written title or a card's words (#802): whether it speaks of something displayed, and which of those claims the chosen shots' content evidence shows, leaves unshown or contradicts. Absent otherwise and in older logs. 'disputed' (#817, only when not empty): the counts for which a chosen shot ties another figure to the same kind of thing (a population), also when another chosen shot shows the stated figure (then also in 'verified'); for review only, never a conflict.",
                       "type": "object", "additionalProperties": false, "required": ["display", "verified", "unverified", "conflicts"],
                       "properties": {"display": {"type": "boolean"},
                                      "verified": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 200}},
                                      "unverified": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 200}},
                                      "conflicts": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 200}},
                                      "disputed": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 200}}}}}}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "start_ms", "end_ms", "shot", "motion", "dhash", "keyframe", "quality", "group", "evidence", "summary"],
      "properties": {
        "id": {"type": "string"}, "source_id": {"type": "string"},
        "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1},
        "shot": {"type": "integer", "minimum": 0}, "motion": {"type": "integer", "minimum": 0, "maximum": 1000},
        "dhash": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "keyframe": {"type": ["string", "null"]},
        "quality": {"type": "object", "additionalProperties": false, "required": ["brightness", "contrast", "sharpness", "problems"],
                    "properties": {"brightness": {"type": "integer"}, "contrast": {"type": "integer"}, "sharpness": {"type": "integer"},
                                   "problems": {"type": "array", "items": {"type": "string"}}}},
        "group": {"type": "string"},
        "summary": {"type": "string", "maxLength": 300},
        "evidence": {"type": ["object", "null"], "additionalProperties": false,
                     "required": ["candidate_id", "items", "product_box", "hook", "product_visible", "same_product"],
                     "properties": {
                       "candidate_id": {"type": "string"},
                       "items": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                 "required": ["origin", "confidence", "text", "labels", "detail"],
                                 "properties": {"origin": {"enum": ["user", "metadata", "transcript", "vision", "signal"]},
                                                "confidence": {"type": "integer", "minimum": 0, "maximum": 1000},
                                                "text": {"type": "string"}, "labels": {"type": "array", "items": {"type": "string"}},
                                                "detail": {"type": "string"}}}},
                       "product_box": {"type": ["object", "null"]},
                       "hook": {"type": "integer", "minimum": 0, "maximum": 1000},
                       "product_visible": {"type": ["boolean", "null"]},
                       "same_product": {"type": ["string", "null"]}}}
      }
    },
    "edits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pin", "exclude", "exclude_sources"],
      "properties": {
        "pin": {"type": "object", "additionalProperties": {"type": "array", "maxItems": 20, "items": {"type": "string"}}},
        "exclude": {"type": "array", "items": {"type": "string"}},
        "exclude_sources": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
