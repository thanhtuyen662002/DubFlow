{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubflow.local/contracts/speakers/schema-v1.json",
  "title": "DubFlow speaker diarization v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "model", "segments", "resource_profile"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$"},
    "model": {"$ref": "#/$defs/model"},
    "segments": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/segment"}},
    "resource_profile": {"$ref": "#/$defs/resource_profile"}
  },
  "$defs": {
    "ticks": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$", "maxLength": 20},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_version", "algorithm"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "algorithm": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "start_ticks", "end_ticks", "speaker_cluster_ids", "role", "confidence", "overlap_group_id"],
      "properties": {
        "segment_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$"},
        "start_ticks": {"$ref": "#/$defs/ticks"},
        "end_ticks": {"$ref": "#/$defs/ticks"},
        "speaker_cluster_ids": {"type": "array", "maxItems": 16, "items": {"type": "string", "pattern": "^spk-[0-9a-f]{16}$"}},
        "role": {"enum": ["speaker", "narrator", "offscreen", "unresolved"]},
        "confidence": {"type": "string", "pattern": "^(0|0\\.[0-9]+|1(?:\\.0+)?)$"},
        "overlap_group_id": {"type": ["string", "null"], "pattern": "^overlap-[0-9a-f]{16}$"}
      }
    },
    "resource_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_duration_ticks", "observation_count", "elapsed_ms", "peak_memory_bytes", "backend"],
      "properties": {
        "input_duration_ticks": {"$ref": "#/$defs/ticks"},
        "observation_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "peak_memory_bytes": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "backend": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  }
}
