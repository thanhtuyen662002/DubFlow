{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubflow.local/contracts/translation/schema-v1.json",
  "title": "DubFlow local translation document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_kind",
    "source_language",
    "target_language",
    "source_utterance_ids",
    "translations",
    "chunks",
    "provenance",
    "failures",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "translation_document" },
    "source_kind": { "const": "asr" },
    "source_language": { "type": "string", "minLength": 2, "maxLength": 32 },
    "target_language": { "const": "vi" },
    "source_utterance_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 256 },
      "uniqueItems": true
    },
    "translations": {
      "type": "array",
      "items": { "$ref": "#/$defs/translation" }
    },
    "chunks": {
      "type": "array",
      "items": { "$ref": "#/$defs/chunk" }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/failure" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    }
  },
  "$defs": {
    "time_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    },
    "time_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "ticks", "time_base"],
      "properties": {
        "kind": { "const": "time_point" },
        "schema_version": { "const": 1 },
        "ticks": { "type": "string", "pattern": "^(0|-?[1-9][0-9]*)$" },
        "time_base": { "$ref": "#/$defs/time_base" }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_utterance_id",
        "source_text",
        "source_normalized_text",
        "translated_text",
        "normalized_text",
        "source_language",
        "target_language",
        "start",
        "end",
        "confidence",
        "chunk_id"
      ],
      "properties": {
        "source_utterance_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source_text": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "source_normalized_text": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "translated_text": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "normalized_text": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "source_language": { "type": "string", "minLength": 2, "maxLength": 32 },
        "target_language": { "const": "vi" },
        "start": { "$ref": "#/$defs/time_point" },
        "end": { "$ref": "#/$defs/time_point" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "chunk_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "index",
        "core_utterance_ids",
        "context_utterance_ids",
        "status",
        "attempt"
      ],
      "properties": {
        "chunk_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "index": { "type": "integer", "minimum": 0 },
        "core_utterance_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "uniqueItems": true
        },
        "context_utterance_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "uniqueItems": true
        },
        "status": { "enum": ["completed", "failed", "skipped"] },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 255 },
        "error_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "artifact_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "checkpoint_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "producer_version",
        "backend_id",
        "model_id",
        "model_version",
        "runtime",
        "timeline_contract",
        "config_hash",
        "model_hash",
        "glossary_hash",
        "input_hash",
        "requested_profile",
        "hardware_profile"
      ],
      "properties": {
        "producer": { "type": "string", "minLength": 1, "maxLength": 128 },
        "producer_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "backend_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "runtime": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timeline_contract": { "const": "timeline-v1" },
        "config_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "model_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "glossary_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "input_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "requested_profile": { "enum": ["auto", "cpu", "gpu", "fixture"] },
        "hardware_profile": { "enum": ["cpu", "gpu", "fixture", "mixed"] },
        "fallback_reason": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "chunk_id",
        "utterance_ids",
        "retryable",
        "attempt",
        "condition",
        "fallback_used"
      ],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "chunk_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "utterance_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "uniqueItems": true
        },
        "retryable": { "type": "boolean" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 255 },
        "condition": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "fallback_used": { "type": "boolean" }
      }
    }
  }
}
