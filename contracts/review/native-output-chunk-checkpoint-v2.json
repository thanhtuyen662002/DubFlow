{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native output-only physical chunk receipt/index/journal v2; no DATA migration, semantic QC or publication grant",
  "oneOf": [{"$ref": "#/$defs/receipt"}, {"$ref": "#/$defs/index"}, {"$ref": "#/$defs/checkpoint"}],
  "$defs": {
    "hash": {"$ref": "longform-plan-v1.json#/$defs/hash"},
    "locator": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "volume_id", "root_kind", "relative_path", "content_hash", "size_bytes"],
      "properties": {"schema_version": {"const": 1}, "volume_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "root_kind": {"const": "output"}, "relative_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "content_hash": {"$ref": "#/$defs/hash"}, "size_bytes": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["path_hint", "format", "locator"],
      "properties": {"path_hint": {"type": "string", "maxLength": 4096}, "format": {"const": "json"}, "locator": {"$ref": "#/$defs/locator"}}},
    "checkpoint": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "job_id", "plan_sha256", "context_sha256", "ordinal", "index"],
      "properties": {"schema_version": {"const": 2}, "kind": {"const": "review_native_output_chunk_checkpoint"},
        "job_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "plan_sha256": {"$ref": "#/$defs/hash"}, "context_sha256": {"$ref": "#/$defs/hash"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 4096}, "index": {"$ref": "#/$defs/record"}}},
    "receipt": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "job_id", "source_sha256", "processing_recipe_sha256", "time_base", "chunk", "origin_plan_sha256", "origin_context_sha256", "file", "semantic_qc_admitted", "active_graph_published"],
      "properties": {"schema_version": {"const": 2}, "kind": {"const": "review_native_output_chunk_receipt"},
        "job_id": {"type": "string", "minLength": 1, "maxLength": 256}, "source_sha256": {"$ref": "#/$defs/hash"},
        "processing_recipe_sha256": {"$ref": "#/$defs/hash"}, "time_base": {"$ref": "longform-plan-v1.json#/properties/time_base"},
        "chunk": {"$ref": "longform-plan-v1.json#/$defs/chunk"},
        "origin_plan_sha256": {"$ref": "#/$defs/hash"}, "origin_context_sha256": {"$ref": "#/$defs/hash"},
        "file": {"$ref": "native-retained-chunk-v1.json#/properties/file"},
        "semantic_qc_admitted": {"const": false}, "active_graph_published": {"const": false}}},
    "index": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "job_id", "source_sha256", "processing_recipe_sha256", "time_base", "origin_plan_sha256", "origin_context_sha256", "ordinal", "previous", "chunk", "complete", "semantic_qc_admitted", "active_graph_published"],
      "properties": {"schema_version": {"const": 2}, "kind": {"const": "review_native_output_chunk_index"},
        "job_id": {"type": "string", "minLength": 1, "maxLength": 256}, "source_sha256": {"$ref": "#/$defs/hash"},
        "processing_recipe_sha256": {"$ref": "#/$defs/hash"}, "time_base": {"$ref": "longform-plan-v1.json#/properties/time_base"},
        "origin_plan_sha256": {"$ref": "#/$defs/hash"}, "origin_context_sha256": {"$ref": "#/$defs/hash"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 4096},
        "previous": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/record"}]},
        "chunk": {"type": "object", "additionalProperties": false, "required": ["chunk_identity", "receipt"],
          "properties": {"chunk_identity": {"$ref": "#/$defs/hash"}, "receipt": {"$ref": "#/$defs/record"}}},
        "complete": {"type": "boolean"}, "semantic_qc_admitted": {"const": false}, "active_graph_published": {"const": false}},
      "allOf": [{"if": {"properties": {"ordinal": {"const": 1}}}, "then": {"properties": {"previous": {"type": "null"}}},
        "else": {"properties": {"previous": {"$ref": "#/$defs/record"}}}}]}
  },
  "$comment": "Every JSON record is at most65536bytes, on freshly observed native output GUID, readonly/single-link/no-follow/fullSHA/size; canonical job/content/format namespace, existing output-wide writer, shared32GiB aggregate old/undo/orphan/alljob quota and fresh2GiB reserve. Native reader checks exact version2 bytes, source/recipe/timebase/job/origin, unique keys, decreasing ordinal/root/current completed prefix, <=4096nodes/16MiB. Immutable markers use .chunk-checkpoint-v2-<64planhex>-<ordinal4digits>.json under the same job store, contiguous1..N, <=4096markers/16MiB; all packets and exact current index predecessor/ordinal/context/local keys/completion reopen independently. Filenames discover progress but grant no source/locator authority. No mutable head or UI pointer is needed to recover this physical prefix; a missing marker, changed collision, foreign packet or corrupt referenced bytes refuses without repair. Absolute hints supply no IO authority. DATA-v1 is not converted or repinned. complete is physical prefix only. Processing/source/runtime/indexed-clock coverage/codec-caption-audio/QC/current token and full pipeline crash qualification remain required; no current render/graph grant or public longform activation."
}
