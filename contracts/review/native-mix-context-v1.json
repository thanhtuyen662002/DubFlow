      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "$ref": "cue-synthesis-v1.json#/$defs/hash"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "artifact_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "metadata_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
