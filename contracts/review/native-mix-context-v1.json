    "request_sha256": {
      "$ref": "cue-synthesis-v1.json#/$defs/hash"
    },
    "source_audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "artifact_root"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "$ref": "cue-synthesis-v1.json#/$defs/hash"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 44,
          "maximum": 4294967303
        },
        "artifact_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "original_tts_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "artifact_root",
        "metadata_root"
