{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private retained mix metadata result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "context_sha256",
    "composition_sha256",
    "mix_document_json",
    "mix_document_sha256",
    "native_media_revalidation_required",
    "active_graph_published"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "review_retained_mix_document"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "composition_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mix_document_json": {
      "type": "string",
      "minLength": 1,
      "maxLength": 67108864
    },
    "mix_document_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "native_media_revalidation_required": {
      "const": true
    },
    "active_graph_published": {
      "const": false
    }
  }
}
