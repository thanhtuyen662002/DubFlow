{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit original-only native desktop Review initialization",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/result"}],
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "confirm", "job_id"],
      "properties": {
        "schema_version": {"const": 1}, "kind": {"const": "review_initialize_current"}, "confirm": {"const": true},
        "job_id": {"$ref": "schema-v2.json#/$defs/id"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "job_id", "session_id", "snapshot"],
      "properties": {
        "schema_version": {"const": 1}, "kind": {"const": "review_desktop_initialized_current"},
        "job_id": {"$ref": "schema-v2.json#/$defs/id"}, "session_id": {"type": "string", "pattern": "^[A-Za-z0-9-]{16,64}$"},
        "snapshot": {"$ref": "schema-v3.json"}
      }
    }
  }
}
