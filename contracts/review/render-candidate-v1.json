{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "render-candidate-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "job_id",
    "mode",
    "context_sha256",
    "execution_identity",
    "after_snapshot_sha256",
    "artifacts",
    "active_graph_published",
    "correction_ready"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "review_private_render_candidate"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mode": {
      "enum": [
        "b1",
        "b2"
      ]
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "execution_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "after_snapshot_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_video",
        "captions_srt",
        "captions_ass",
        "corrected_timeline",
        "qc_report"
      ],
      "properties": {
        "final_video": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32767
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "captions_srt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32767
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "captions_ass": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32767
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "corrected_timeline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32767
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "qc_report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32767
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[1-9][0-9]*$"
            }
          }
        }
      }
    },
    "active_graph_published": {
      "const": false
    },
    "correction_ready": {
      "const": false
    }
  }
}
