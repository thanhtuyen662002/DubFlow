{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native prepared current B1/B2 timeline; private metadata only",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "current_token", "mode", "context", "proposal", "corrected_timeline", "processing_timeline", "model_weights_verified", "media_executed", "active_graph_published", "correction_ready"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"const": "review_native_prepared_effective_timeline"},
    "current_token": {"$ref": "effective-cue-context-v1.json#/$defs/token"}, "mode": {"enum": ["b1", "b2"]},
    "context": {"$ref": "native-effective-state-v1.json#/$defs/document"},
    "proposal": {"$ref": "native-effective-state-v1.json#/$defs/document"},
    "corrected_timeline": {"$ref": "native-effective-state-v1.json#/$defs/document"},
    "processing_timeline": {"$ref": "native-processing-effective-timeline-v1.json"},
    "model_weights_verified": {"const": false}, "media_executed": {"const": false},
    "active_graph_published": {"const": false}, "correction_ready": {"const": false}
  }
}
