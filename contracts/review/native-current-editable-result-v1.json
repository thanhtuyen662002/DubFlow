{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native current corrected editable publication; worker hints confer no authority",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "current_token", "generation", "path", "manifest_sha256", "bundle_manifest_sha256", "processing_receipt", "context_sha256", "worker", "files_verified", "standard_bundle_published", "production_editable_pack_published", "current_generation_checked", "vendor_execution", "active_graph_changed", "correction_ready"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"const": "review_native_current_editable_result"},
    "current_token": {"$ref": "native-current-export-manifest-v1.json#/properties/current_token"},
    "generation": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 32767},
    "manifest_sha256": {"$ref": "cue-synthesis-v1.json#/$defs/hash"},
    "bundle_manifest_sha256": {"$ref": "cue-synthesis-v1.json#/$defs/hash"},
    "processing_receipt": {"$ref": "native-processing-editable-pack-v1.json"},
    "context_sha256": {"$ref": "cue-synthesis-v1.json#/$defs/hash"},
    "worker": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/worker"}]},
    "files_verified": {"enum": [10, 13]},
    "standard_bundle_published": {"const": true}, "production_editable_pack_published": {"const": true},
    "current_generation_checked": {"const": true}, "vendor_execution": {"const": false},
    "active_graph_changed": {"const": false}, "correction_ready": {"const": false}
  },
  "$defs": {
    "worker": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "context_sha256", "current_token", "bundle_manifest_sha256", "generation", "processing_recipe_identity", "candidate_path", "candidate_manifest_sha256", "pack_format", "resource_count", "current_generation_checked", "active_graph_published", "correction_ready"],
      "properties": {
        "schema_version": {"const": 1}, "kind": {"const": "review_private_editable_pack_candidate"},
        "context_sha256": {"$ref": "cue-synthesis-v1.json#/$defs/hash"},
        "current_token": {"$ref": "native-current-export-manifest-v1.json#/properties/current_token"},
        "bundle_manifest_sha256": {"$ref": "cue-synthesis-v1.json#/$defs/hash"},
        "generation": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "processing_recipe_identity": {"$ref": "cue-synthesis-v1.json#/$defs/hash"},
        "candidate_path": {"type": "string", "minLength": 1, "maxLength": 32767},
        "candidate_manifest_sha256": {"$ref": "cue-synthesis-v1.json#/$defs/hash"},
        "pack_format": {"const": 2}, "resource_count": {"enum": [7, 10]},
        "current_generation_checked": {"const": false}, "active_graph_published": {"const": false}, "correction_ready": {"const": false}
      }
    }
  }
}
