{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Private native current B1 render; no TTS/mix or graph publication",
  "required": [
    "schema_version",
    "kind",
    "current_token",
    "context",
    "proposal",
    "corrected_timeline",
    "processing_timeline",
    "private_render",
    "tts_executed",
    "mix_executed",
    "render_executed",
    "model_weights_verified",
    "active_graph_published",
    "correction_ready"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "review_native_rendered_effective_b1"
    },
    "current_token": {
      "$ref": "effective-cue-context-v1.json#/$defs/token"
    },
    "context": {
      "$ref": "native-effective-state-v1.json#/$defs/document"
    },
    "proposal": {
      "$ref": "native-effective-state-v1.json#/$defs/document"
    },
    "corrected_timeline": {
      "$ref": "native-effective-state-v1.json#/$defs/document"
    },
    "processing_timeline": {
      "$ref": "native-processing-effective-timeline-v1.json"
    },
    "private_render": {
      "$ref": "native-effective-render-private-v1.json"
    },
    "tts_executed": {
      "const": false
    },
    "mix_executed": {
      "const": false
    },
    "render_executed": {
      "const": true
    },
    "model_weights_verified": {
      "const": false
    },
    "active_graph_published": {
      "const": false
    },
    "correction_ready": {
      "const": false
    }
  }
}
