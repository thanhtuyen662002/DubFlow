{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native current Review display projection; durable v2 snapshot/token remain unchanged",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "job_id", "current_token", "mode", "time_base", "findings", "last_plan", "correction_ready"],
  "properties": {
    "schema_version": {"const": 3}, "kind": {"const": "review_current_snapshot"},
    "job_id": {"$ref": "schema-v2.json#/$defs/id"},
    "current_token": {"$ref": "native-current-export-manifest-v1.json#/properties/current_token"},
    "mode": {"enum": ["b1", "b2"]}, "time_base": {"$ref": "schema-v2.json#/properties/time_base"},
    "findings": {"$ref": "schema-v2.json#/properties/findings"}, "last_plan": {"$ref": "schema-v2.json#/properties/last_plan"},
    "correction_ready": {"const": false}
  }
}
