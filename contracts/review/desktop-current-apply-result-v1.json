{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native desktop session after committed current graph was physically reopened",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "before_token", "session_id", "snapshot"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"const": "review_desktop_applied_current"},
    "before_token": {"$ref": "effective-cue-context-v1.json#/$defs/token"},
    "session_id": {"type": "string", "pattern": "^[A-Za-z0-9-]{16,64}$"},
    "snapshot": {"$ref": "schema-v3.json"}
  }
}
