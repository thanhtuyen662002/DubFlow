{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Separate current-mix processing capability with unchanged original protected DSP",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "capability", "processing_synthesis", "capability_document", "mix_entry", "dependencies", "render_execution_admitted", "active_graph_published"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "review_admitted_effective_mix"},
    "capability": {"const": "review_effective_mix_v1"},
    "processing_synthesis": {"$ref": "native-processing-cue-synthesis-v1.json"},
    "capability_document": {"$ref": "native-processing-release-v1.json#/$defs/metadata"},
    "mix_entry": {"$ref": "native-processing-release-v1.json#/properties/effective_cue_entry"},
    "dependencies": {"type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "native-processing-cue-synthesis-v1.json#/properties/recipe_dependencies/items"}},
    "render_execution_admitted": {"const": false},
    "active_graph_published": {"const": false}
  }
}
