{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native sealed metadata split launch binding v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "action",
    "current_token",
    "context_pin",
    "processing_authority_receipt_pin",
    "original_producer_sha256",
    "roles",
    "recipe_dependencies",
    "execution_recipe_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "review_native_split_launch_binding_v2"
    },
    "action": {
      "$ref": "native-processing-roles-v2.json#/$defs/action"
    },
    "current_token": {
      "$ref": "effective-cue-context-v1.json#/$defs/token"
    },
    "context_pin": {
      "$ref": "native-processing-roles-v2.json#/$defs/descriptor",
      "allOf": [
        {
          "properties": {
            "pin": {
              "properties": {
                "size_bytes": {
                  "minimum": 1,
                  "maximum": 67108864
                }
              }
            }
          }
        }
      ]
    },
    "processing_authority_receipt_pin": {
      "$ref": "native-processing-roles-v2.json#/$defs/pin",
      "allOf": [
        {
          "properties": {
            "size_bytes": {
              "minimum": 1,
              "maximum": 16777216
            }
          }
        }
      ]
    },
    "original_producer_sha256": {
      "$ref": "cue-synthesis-v1.json#/$defs/hash"
    },
    "roles": {
      "$ref": "native-processing-roles-v2.json"
    },
    "recipe_dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "native-processing-roles-v2.json#/$defs/dependency"
      }
    },
    "execution_recipe_sha256": {
      "$ref": "cue-synthesis-v1.json#/$defs/hash"
    }
  },
  "$comment": "All actual input/output UTF8 bytes, including wrapper escaping and result envelope, share the native64MiB bound. Correlated action/current-token/authority/recipe checks are mandatory in both readers."
}
