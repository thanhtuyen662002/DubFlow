{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private exact-source-clock Review video chunk plan; no media admission or publication authority",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "recipe", "context_sha256", "source_sha256", "processing_recipe_sha256", "time_base", "source_interval", "policy", "frame_count", "frame_clock_sha256", "chunks"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"const": "review_longform_render_plan"},
    "recipe": {"const": "review-source-pts-chunks-v1"},
    "context_sha256": {"$ref": "#/$defs/hash"}, "source_sha256": {"$ref": "#/$defs/hash"},
    "processing_recipe_sha256": {"$ref": "#/$defs/hash"}, "frame_clock_sha256": {"$ref": "#/$defs/hash"},
    "time_base": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"],
      "properties": {"numerator": {"$ref": "#/$defs/positive"}, "denominator": {"$ref": "#/$defs/positive"}}},
    "source_interval": {"type": "object", "additionalProperties": false, "required": ["start_tick", "end_tick"],
      "properties": {"start_tick": {"$ref": "#/$defs/tick"}, "end_tick": {"$ref": "#/$defs/tick"}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["target_ticks", "max_frames", "max_chunks"],
      "properties": {"target_ticks": {"$ref": "#/$defs/positive"},
        "max_frames": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_chunks": {"type": "integer", "minimum": 1, "maximum": 4096}}},
    "frame_count": {"$ref": "#/$defs/positive"},
    "chunks": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/chunk"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "positive": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "tick": {"type": "string", "pattern": "^(0|-?[1-9][0-9]{0,18})$"},
    "chunk": {"type": "object", "additionalProperties": false,
      "required": ["start_tick", "end_tick", "frame_count", "frame_clock_sha256", "visual_dependencies_sha256", "identity"],
      "properties": {"start_tick": {"$ref": "#/$defs/tick"}, "end_tick": {"$ref": "#/$defs/tick"},
        "frame_count": {"$ref": "#/$defs/positive"}, "frame_clock_sha256": {"$ref": "#/$defs/hash"},
        "visual_dependencies_sha256": {"$ref": "#/$defs/hash"}, "identity": {"$ref": "#/$defs/hash"}}}
  }
}
