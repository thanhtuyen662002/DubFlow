{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owned prepared cue request v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "context_sha256", "request_json", "request_sha256", "config", "voice", "model_weights_verified"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "review_prepared_cue_request"},
    "context_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "request_json": {"type": "string", "minLength": 1, "maxLength": 32768},
    "config": {"type": "object"},
    "voice": {"type": "object"},
    "model_weights_verified": {"const": false}
  }
}
