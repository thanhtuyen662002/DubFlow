{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native completed-export original metadata seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "job_id", "manifest_sha256", "snapshot_json", "graph_json"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "review_original_seed"},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$"},
    "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "snapshot_json": {"type": "string", "minLength": 1, "maxLength": 67108864},
    "graph_json": {"type": "string", "minLength": 1, "maxLength": 67108864}
  }
}
