{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubflow.local/contracts/source/schema-v1.json",
  "title": "DubFlow source adapter contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "title", "media_candidates", "subtitle_candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "identity": {"$ref": "#/$defs/identity"},
    "title": {"type": "string", "minLength": 1, "maxLength": 4096},
    "description": {"type": ["string", "null"], "maxLength": 16384},
    "duration_ticks": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20},
    "media_candidates": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/media_candidate"}},
    "subtitle_candidates": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/subtitle_candidate"}},
    "failures": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/page_failure"}}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "source_id", "canonical_url", "identity_key"],
      "properties": {
        "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "canonical_url": {"type": "string", "format": "uri", "maxLength": 4096},
        "identity_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}:[^\\x00-\\x1f]{1,512}$"}
      }
    },
    "media_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "locator", "kind", "mime_type"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "locator": {"type": "string", "minLength": 1, "maxLength": 4096},
        "kind": {"enum": ["progressive", "hls", "dash", "local"]},
        "mime_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "width": {"type": ["integer", "null"], "minimum": 1, "maximum": 18446744073709551615},
        "height": {"type": ["integer", "null"], "minimum": 1, "maximum": 18446744073709551615},
        "has_audio": {"type": "boolean"}
      }
    },
    "subtitle_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "locator", "language", "format"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "locator": {"type": "string", "minLength": 1, "maxLength": 4096},
        "language": {"type": "string", "pattern": "^(?:und|[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*)$"},
        "format": {"enum": ["srt", "vtt", "ass", "json"]}
      }
    },
    "page_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "code", "condition", "retryable"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "code": {"enum": ["AUTH_REQUIRED", "RATE_LIMITED", "SOURCE_CHANGED", "NOT_FOUND", "PRIVATE", "NETWORK", "UNSUPPORTED", "INVALID_INPUT", "CHECKPOINT_INVALID"]},
        "condition": {"type": "string", "minLength": 1, "maxLength": 4096},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
